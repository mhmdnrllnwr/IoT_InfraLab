# 2. Nmap Port Scan (Stealth SYN)
drop tcp any any -> any any (msg:"Nmap SYN Stealth Scan Detected"; flow:stateless; flags:S; threshold:type both, track by_src, count 8, seconds 10; classtype:attempted-recon; sid:1000002; rev:3;)
>>>>>>> 8d5e5a733910cea6332c78e6a5dc2eed0c77911d

# ---------- 3. PROTOCOL MISMATCH ----------
drop tcp any any -> any 1883 (msg:"Protocol Mismatch: HTTP Method sent to MQTT Broker"; flow:to_server,established; pcre:"/^(GET|POST|PUT|DELETE)\\s+/i"; classtype:protocol-command-decode; sid:1000003; rev:2;)

# ---------- 4a. ROGUE SUBSCRIBER (Native Parser) ----------
drop mqtt any any -> any 1883 (msg:"Rogue Subscriber Detected: MQTT Wildcard '#'"; mqtt.subscribe.topic; content:"#"; classtype:attempted-recon; sid:1000005; rev:2;)

# ---------- 4b. ROGUE SUBSCRIBER (Raw Hex) ----------
drop tcp any any -> any 1883 (msg:"Rogue Subscriber Detected: Raw Hex Wildcard '#'"; flow:to_server; content:"|00 01 23|"; classtype:attempted-recon; sid:1000007; rev:2;)

# ---------- 5. APP-LAYER DoS ----------
drop mqtt any any -> any 1883 (msg:"MQTT DoS: Rapid Flood Detected"; threshold:type both, track by_src, count 50, seconds 1; classtype:attempted-dos; sid:1000009; rev:1;)

# ---------- 6. FAKE TELEMETRY ----------
drop tcp any any -> any 1883 (msg:"MQTT Injection: Fake Telemetry Detected"; flow:to_server,established; content:"fake_injection"; nocase; classtype:attempted-recon; sid:1000010; rev:1;)
