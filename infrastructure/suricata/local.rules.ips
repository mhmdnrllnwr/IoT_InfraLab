# ==========================================
# local.rules.ips — IPS MODE (Drop/Block)
# ==========================================
# Drops packets. NOTE: IPS not operational on
# WSL2 (kernel missing NFQUEUE). Downgrades
# to alert mode automatically.
# ==========================================

# ---------- SAFELIST ----------
pass ip 172.18.0.100 any <> any any (msg:"SAFELIST — Security Auditor"; sid:9900001; rev:1;)
pass ip 172.18.0.25 any <> any any (msg:"SAFELIST — Node-RED"; sid:9900002; rev:1;)
pass ip 172.18.0.10 any <> any any (msg:"SAFELIST — Promtail"; sid:9900003; rev:1;)

# ---------- 1. SYN FLOOD ----------
drop tcp any any -> any 1883 (msg:"DoS Attempt: MQTT SYN Flood Detected"; flow:to_server,stateless; flags:S; threshold:type both, track by_src, count 100, seconds 1; classtype:attempted-dos; sid:1000001; rev:2;)

